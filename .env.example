# Required for admin and your real library. With all three unset, the app shows the starter catalogue.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# One admin. Use a unique password of 16+ characters and a random session secret of 32+ characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Canonical origin, including https:// in production. Falls back to Vercel's URL or localhost.
SITE_URL=http://localhost:3000

# Show the starter catalogue when the database has no series. Use false to show an empty library.
SHOW_DEMO_WHEN_EMPTY=true

# Optional. Enable Web Analytics on the Vercel project's Analytics tab as well.
ENABLE_ANALYTICS=false

# Optional. Copy these values from https://giscus.app and enable comments in Site settings.
GISCUS_REPO=
GISCUS_REPO_ID=
GISCUS_CATEGORY=
GISCUS_CATEGORY_ID=
